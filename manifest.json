{
    "manifest_version": 3,
    "name": "Horo+",
    "version": "67.42.109",
    "icons":  {
      "128": "assets/logo_128.png",
      "48": "assets/logo_48.png",
      "32": "assets/logo_32.png",
      "16": "assets/logo_16.png",
      "64": "assets/logo_64.png"
    },
    "description": "Horo+ is a browser extension that aims to make the HDP platform better by removing bloat, fixing annoying or inconsistent behaviour and adding new convenience feautures.",
    "content_scripts": [
      {
        "matches": ["*://horodigital.ru/*"],
        "js": ["content_early.js"],
        "run_at": "document_start",
        "world": "MAIN",
        "all_frames": false
      },
      {
        "matches": ["*://horodigital.ru/*"],
        "js": ["content.js"],
        "css": ["style.css", "dark.css", "cookie-plus.css"],
        "run_at": "document_idle",
        "world": "MAIN",
        "all_frames": false
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["assets/cookie-plus/*"],
        "matches": ["*://horodigital.ru/*"]
      }
    ],
    "permissions": ["webNavigation"],
    "host_permissions": ["*://horodigital.ru/*"]
  }