(() => {
    'use strict';

    function matchesTaskPath() {
        return /^\/student\/topic\/.*\/task\/.*$/.test(location.pathname);
    }

    function main(link) {
        if (location.pathname == "/student") {
            const applyStyle = () => {
                if (document.body.style.overflowX !== "hidden") {
                    document.body.style.setProperty("overflow-x", "hidden", "important");
                }
            };
            applyStyle();
            const observer = new MutationObserver(applyStyle);
            observer.observe(document.body, { attributes: true, attributeFilter: ["style", "class"] });
        }
        else if (location.pathname == "/student/tasks") {
            const observer = new MutationObserver((mutations, obs) => {
                const button = document.querySelector('._status_1rpl5_7._appointed_1rpl5_22');
                if (button) {
                    button.click();
                    obs.disconnect();
                }
            });
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
            const observer2 = new MutationObserver((mutations, obs) => {
                const bloat = document.querySelector('.colored._p2_fmg0z_6._bold_fmg0z_21._filterTitle_ex5fq_14');
                if (bloat) {
                    bloat.remove();
                    obs.disconnect();
                }
            });
            observer2.observe(document.body, {
                childList: true,
                subtree: true
            });
            
        }
        else if (matchesTaskPath()) {
           addRemoveMarkdown();
        }
    }

    main(location.pathname);
    
    

    // const observer = new MutationObserver((mutations, obs) => {
    //     const button = document.querySelector('._status_1rpl5_7._appointed_1rpl5_22');
    //     if (button) {
    //         button.click();
    //         obs.disconnect();
    //     }
    // });
    // observer.observe(document.body, {
    //     childList: true,
    //     subtree: true
    // });




    // const mdObserver = new MutationObserver((mutations, obs) => {
    //     const eman = document.getElementById('chat_message_input');
    //     if (eman) {
    //         addRemoveMarkdown();
    //         obs.disconnect();
    //     }
    // })
    // mdObserver.observe(document.body, {
    //     childList: true,
    //     subtree: true
    // })


    function addRemoveMarkdown() {
        const TARGET_ID = 'chat_message_input';
        const TARGET_PATH_RE = /^\/student\/topic\/[^/]+\/task\/[^/]+(?:\/|$)/;
      
        // -------------------------------------------------------------------------
        // Strip formatting: HTML -> plain text (keeping line/paragraph breaks) -> HTML
        // -------------------------------------------------------------------------
        function stripFormatting() {
          const el = document.getElementById(TARGET_ID);
          if (!el) { console.warn('[strip] #' + TARGET_ID + ' not found'); return; }
      
          // Prefer TinyMCE's API so its internal model / undo / autosave stay coherent.
          let tiny = null;
          if (window.tinymce && typeof window.tinymce.get === 'function') {
            tiny = window.tinymce.get(TARGET_ID) || null;
          }
      
          const sourceHtml = (tiny && typeof tiny.getContent === 'function')
            ? tiny.getContent()
            : el.innerHTML;
      
          const doc = new DOMParser().parseFromString(
            '<!doctype html><body>' + sourceHtml, 'text/html'
          );
      
          const isBlock = t => /^(p|div|li|h[1-6]|blockquote|pre|section|article|tr|hr|ul|ol|table|thead|tbody)$/i.test(t);
          const isSkip  = t => /^(script|style|noscript|template)$/i.test(t);
      
          let out = '';
          const ensureNewline = () => { if (out.length && !out.endsWith('\n')) out += '\n'; };
      
          const walk = (node) => {
            if (node.nodeType === 3) {
              const t = node.nodeValue.replace(/\u00a0/g, ' ');
              if (t.trim() === '') {
                if (out.length && !out.endsWith(' ') && !out.endsWith('\n')) out += ' ';
              } else {
                out += t;
              }
              return;
            }
            if (node.nodeType !== 1) return;
            const tag = node.tagName;
            if (isSkip(tag)) return;
            if (tag === 'BR') { out += '\n'; return; }
            if (isBlock(tag)) {
              ensureNewline();
              for (const c of node.childNodes) walk(c);
              out += '\n';
            } else {
              for (const c of node.childNodes) walk(c);
            }
          };
          for (const c of doc.body.childNodes) walk(c);
      
          const plain = out
            .replace(/\r\n?/g, '\n')
            .replace(/[ \t]+\n/g, '\n')
            .replace(/^\n+|\n+$/g, '');
      
          const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          const newHtml = plain.length === 0
            ? ''
            : plain.split('\n').map(line => {
                if (line.trim() === '') return '<p><br></p>';
                let safe = esc(line);
                safe = safe.replace(/^ /, '&nbsp;').replace(/ $/, '&nbsp;');
                return '<p>' + safe + '</p>';
              }).join('');
      
          if (tiny && typeof tiny.setContent === 'function') {
            tiny.setContent(newHtml);
          } else {
            el.innerHTML = newHtml;
            el.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: plain }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
          }
          return newHtml;
        }
      
        function onKeyDown(ev) {
          if (ev.repeat) return;
      
          // Match on `code` so Shift uppercasing (`X`) doesn't matter and it's layout-stable.
          if (ev.code !== 'KeyX') return;
          if (!ev.ctrlKey || !ev.shiftKey || ev.altKey || ev.metaKey) return;
      
          // Only on target pages (URL check as a safety net beyond the manifest match).
          if (!TARGET_PATH_RE.test(location.pathname)) return;
      
          // Only when the editor (or something inside it) has focus.
          const el = document.getElementById(TARGET_ID);
          if (!el) return;
          const active = document.activeElement;
          const focused = active === el || el.contains(active);
          if (!focused) return;
      
          // Beat TinyMCE's own key handlers, then run.
          ev.preventDefault();
          ev.stopPropagation();
          ev.stopImmediatePropagation();
          stripFormatting();
        }
        // Capture phase so we run before any page-level handlers.
        document.addEventListener('keydown', onKeyDown, true);
    }

    if ("navigation" in window) {
        window.navigation.addEventListener("navigatesuccess", () => {
        main(location.href);
    });
    }
})();